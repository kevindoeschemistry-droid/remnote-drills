  {
   "id": "ENERGY",
   "title": "Energy is required and transformed",
   "text": "Free energy, coupling and catalysis decide which processes run and how fast."
  },
  {
   "id": "STRUCTURE",
   "title": "Structure determines function",
   "text": "Folding and binding energetics set what a macromolecule does."
  },
  {
   "id": "INFORMATION",
   "title": "Information is stored and flows",
   "text": "Sequence encodes structure; replication, transcription and translation move it."
  },
  {
   "id": "REGULATION",
   "title": "Homeostasis is regulated and far from equilibrium",
   "text": "Control points, signals and steady states keep cells running."
  },
  {
   "id": "MEASURE",
   "title": "Discovery requires measurement",
   "text": "Quantitative methods turn molecules into numbers."
  }
