  "note": "Reactor-theory units follow the NRC Generic Fundamentals Examination topic list (read in part). Nuclear physics and shielding follow the DOE fundamentals handbook's first module (read in part). Health-physics standards for the radiation-protection unit have not been looked at."
 },
 "big_ideas": [
  {
   "id": "BALANCE",
   "title": "A reactor is a neutron balance",
   "text": "Each generation, neutrons are produced by fission and lost to absorption and leakage. Critical means the two are equal; everything an operator does shifts one side of that balance."
  },
  {
   "id": "EXPONENTIAL",
   "title": "Decay, attenuation and power all go exponentially",
   "text": "A constant fractional rate gives a half-life, a half-value layer or a reactor period. One piece of mathematics, three settings."
  },
  {
   "id": "DELAYED",
   "title": "A small delayed fraction makes control possible",
   "text": "Fewer than one neutron in a hundred is delayed, yet those set the timescale of every normal power change."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Compute",
   "text": "Carry a decay, shielding, criticality or kinetics relation to a number."
  },
  {
   "id": "P2",
   "title": "Predict the direction",
   "text": "Say whether a change adds or removes reactivity, dose or heat, and why."
  },
  {
   "id": "P3",
   "title": "Recall an anchor",
   "text": "Know the handful of magnitudes the field runs on."
  }
 ],
 "units": [
  {
   "id": "nuclei",
   "n": 1,
   "title": "Nuclei and radioactive decay",
   "scope": "core",
   "std": [
    "doe-hdbk-1019:1",
    "ngss-hs:PS1-8",
    "ib-physics-2025:E.3",
    "icho-appendix-c:c2",
    "gre-physics:9",
    "aamc-mcat-outline:4E"
   ],
   "ideas": [
    "EXPONENTIAL"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Nuclides and decay modes",
     "los": [
      {
       "id": "A",
       "std": [
        "doe-hdbk-1019:1"
       ],
       "do": "Read nuclide notation and find the daughter of an alpha, beta-minus or positron decay.",
       "ek": [
        "N = A − Z; charge and nucleon number are conserved in every decay."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "nu-neutron-number",
        "nu-decay-daughter"
       ]
      },
      {
       "id": "B",
       "std": [
        "doe-hdbk-1019:1"
       ],
       "do": "Turn a mass defect into a binding energy per nucleon.",
       "ek": [
        "1 u = 931.5 MeV; the curve peaks near iron at about 8.8 MeV per nucleon."
       ],
       "p": [
        "P1",
        "P3"
       ],
       "drills": [
        "nu-binding-energy",
        "nu-defect-from-b"
       ]
      }
     ]
    },
    {
     "n": 2,
     "title": "The decay law",
     "los": [
      {
       "id": "A",
       "std": [
        "doe-hdbk-1019:1"
       ],
       "do": "Use a half-life to find the fraction remaining, the time to reach a given fraction, and the decay constant.",
       "ek": [
        "N = N₀(½)^(t/T); λ = ln 2 / T; ten half-lives is a factor of about a thousand."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "nu-fraction-remaining",
        "nu-time-to-decay",
        "nu-decay-constant"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "radiation",
   "n": 2,
   "title": "Radiation, dose and shielding",
   "scope": "core",
   "std": [
    "doe-hdbk-1019:1",
    "ngss-hs:PS4-4"
   ],
   "ideas": [
    "EXPONENTIAL"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Distance and shielding",
     "los": [
      {
       "id": "A",
       "std": [
        "doe-hdbk-1019:1"
       ],
       "do": "Apply the inverse-square law to a point source.",
       "ek": [
        "Dose rate × r² is constant."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "nu-inverse-square",
        "nu-distance-for-rate"
       ]
      },
      {
       "id": "B",
       "std": [
        "doe-hdbk-1019:1"
       ],
       "do": "Compute gamma attenuation from a linear attenuation coefficient or a half-value layer, and choose a shield for each kind of radiation.",
       "ek": [
        "I = I₀e^(−μx); HVL = ln 2 / μ; paper for alpha, plastic for beta, dense for gamma, hydrogen for neutrons."
       ],
       "p": [
        "P1",
        "P2"
       ],
       "drills": [
        "nu-half-value-layers",
        "nu-attenuation-coefficient",
        "nu-shielding-choice"
       ]
      }
     ]
    },
    {
     "n": 2,
     "title": "Dose",
     "los": [
      {
       "id": "A",
       "do": "Convert an absorbed dose to an equivalent dose.",
       "ek": [
        "H (Sv) = w_R × D (Gy); w_R is 1 for photons and betas, 20 for alphas."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "nu-equivalent-dose",
        "nu-effective-dose"
       ]
      }
     ]
    }
   ]
  },
