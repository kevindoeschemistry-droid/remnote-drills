       "id": "A",
       "std": [
        "nrc-gfe:192002"
       ],
       "do": "Compute k-effective from the six factors and classify the state of a core.",
       "ek": [
        "k_eff = ε L_f p L_t f η; subcritical, critical, delayed supercritical, prompt critical."
