       ]
      },
      {
       "id": "B",
       "std": [
        "nrc-gfe:192002"
       ],
       "do": "Convert k-effective to reactivity.",
       "ek": [
        "ρ = (k − 1)/k; 1 pcm = 10⁻⁵; one dollar is ρ = β."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "nu-reactivity-pcm",
        "nu-k-from-rho"
       ]
      }
     ]
