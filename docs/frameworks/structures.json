 "big_ideas": [
  {
   "id": "COLD",
   "title": "A structure is vocabulary",
   "text": "You cannot reason about a mechanism or a pathway while reconstructing what the molecule looks like. The common structures have to come out as fast as a word does."
  },
  {
   "id": "FAMILY",
   "title": "Learn one, vary it",
   "text": "Most structures are a parent with one change (phenol is benzene with an OH; galactose is glucose flipped at C-4). Carry the parent and the change."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Produce",
   "text": "Draw the structure from its name on paper, with nothing to look at, in under a minute."
  },
  {
   "id": "P2",
   "title": "Recognise",
   "text": "Name a drawn structure in a few seconds."
  }
 ],
