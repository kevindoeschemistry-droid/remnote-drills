     "n": 1,
     "title": "Time value of money",
     "los": [
      {
       "id": "A",
       "do": "Convert a nominal rate to an effective annual rate.",
       "ek": [
        "(1 + r/m)^m − 1."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "pd-effective-rate",
        "pd-nominal-from-effective"
       ]
      },
      {
       "id": "B",
       "do": "Compute a project's net present value.",
       "ek": [
        "NPV = −I + A(P/A,i,n) + S(1+i)⁻ⁿ."
       ],
       "p": [
        "P1"
       ],
       "needs": [
