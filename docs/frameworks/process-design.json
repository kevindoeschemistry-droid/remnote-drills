       ],
       "p": [
        "P1"
       ],
       "drills": [
        "pd-cost-scaling",
        "pd-capacity-from-budget"
       ]
      },
      {
       "id": "B",
       "do": "Compute book value under straight-line or declining-balance depreciation.",
       "ek": [
