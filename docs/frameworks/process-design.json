  ],
  "note": "Topics from FE Chemical areas 13, 15, 16 and PE Chemical area 7 (read in full); objectives and their order are ours."
 },
 "big_ideas": [
  {
   "id": "MONEY",
   "title": "Money has a time value",
   "text": "A dollar later is worth less than a dollar now; every economic comparison discounts to one date."
  },
  {
   "id": "LAYERS",
   "title": "Safety is layers",
   "text": "Keep fuel out of its flammable range, exposures under their limits, and find deviations before they happen."
  },
  {
   "id": "DYN",
   "title": "Processes respond with a lag",
   "text": "A first-order process reaches 63% of a step change in one time constant; control design starts there."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Compute",
   "text": "Carry the calculation to a number."
  },
  {
   "id": "P2",
   "title": "Judge",
   "text": "Decide whether a design or exposure is acceptable."
  }
 ],
