       "do": "Turn a spoonful of water into grams and moles.",
       "ek": [
        "Water is 1 g/mL and 18 g/mol, so a tablespoon is a little under a mole."
       ],
       "p": [
        "P2"
       ],
       "drills": [
        "aq-spoon-of-water",
        "aq-spoons-per-mole"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "thermal",
   "n": 2,
   "title": "Thermal energy",
   "scope": "core",
   "ideas": [
