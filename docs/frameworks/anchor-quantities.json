   "topics": [
    {
     "n": 1,
     "title": "RT and kT at room temperature",
     "los": [
      {
       "id": "A",
       "std": [
        "acs-accm-pchem:X.C.2"
       ],
       "do": "Recall RT and k_BT at 25 °C in kJ/mol, kcal/mol, meV, cm⁻¹ and pN·nm.",
       "ek": [
        "RT ≈ 2.48 kJ/mol ≈ 0.593 kcal/mol; k_BT ≈ 25.7 meV ≈ 207 cm⁻¹ ≈ 4.1 pN·nm."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "aq-thermal-energy",
        "aq-rt-at-t"
       ]
      },
      {
       "id": "B",
       "std": [
        "acs-accm-pchem:X.D.3",
        "acs-accm-pchem:X.C.2"
       ],
       "do": "Estimate a Boltzmann population ratio for a gap of a few k_BT.",
       "ek": [
        "N₂/N₁ = e^(−ΔE/k_BT): 0.37, 0.14, 0.05 for 1, 2, 3 k_BT."
       ],
       "p": [
        "P2"
       ],
       "drills": [
        "aq-boltzmann-ratio",
        "aq-gap-for-ratio"
       ]
      }
     ]
