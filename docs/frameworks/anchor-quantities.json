     "los": [
      {
       "id": "A",
       "std": [
        "acs-accm-pchem:VIII.F.2",
        "acs-accm-pchem:VIII.D.1"
       ],
       "do": "Recall the free-energy cost of a factor of ten in an equilibrium constant.",
       "ek": [
        "RT ln 10 ≈ 5.7 kJ/mol ≈ 1.36 kcal/mol at 25 °C."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "aq-factor-of-ten",
        "aq-dg-for-factor"
       ]
      },
      {
       "id": "B",
       "std": [
        "acs-accm-pchem:VIII.F.2",
        "acs-accm-pchem:VIII.D.1"
       ],
       "do": "Convert a standard free energy to the order of magnitude of K in one step.",
       "ek": [
        "log₁₀K = −ΔG°/(5.7 kJ/mol)."
       ],
       "p": [
        "P2"
       ],
       "drills": [
        "aq-free-energy-to-K",
        "aq-k-to-dg"
       ]
      }
     ]
    }
