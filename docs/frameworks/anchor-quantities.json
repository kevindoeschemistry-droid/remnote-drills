 "level": 4,
 "domains": [],
 "basis": {
  "primary": "codata-2022",
  "also": [
   "snapshot-key-numbers",
   "francl-take-a-number",
   "cfr-21-101-9",
   "acs-accm-pchem"
  ],
  "note": "Values from CODATA 2022, standard atomic weights and 21 CFR 101.9. Which values to carry is a house list for units 1–4 and the SnapShot Key Numbers in Biology sheet for units 5–6. No chemistry standard lists these values; the ACS Physical Chemistry content map (read) asks for the mole-scale and Boltzmann reasoning they serve, and AQ objectives cite those articulations."
 },
 "big_ideas": [
  {
   "id": "FEEL",
   "title": "A number should mean something",
   "text": "Knowing that a teaspoon is 5 mL, that water is 55 M, or that a tablespoon of water is about a mole turns a computed answer into something you can picture and sanity-check."
  },
  {
   "id": "SCALE",
   "title": "Compare with the natural scale",
   "text": "An energy is large or small against k_BT, a length against a bond or a protein, a count against Avogadro's number. Carrying the scale lets you estimate an answer before computing it."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Recall the anchor",
   "text": "Give the value, with its unit, to within a few percent, without looking it up."
  },
  {
   "id": "P2",
   "title": "Use the anchor",
   "text": "Chain one or two anchors into an estimate good to about ten percent."
  }
 ],
 "units": [
