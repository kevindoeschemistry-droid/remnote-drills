 "draft": 1,
 "track": "math",
 "requires": [
  "math-hs"
 ],
 "level": 2,
 "domains": [
  "stats"
 ],
 "basis": {
  "primary": "ap-statistics-2026",
  "also": [
   "webwork-opl"
  ],
  "note": "Units follow the revised AP Statistics course (2026-27), of which only the unit list was read. The objectives under each unit are a house list."
 },
 "big_ideas": [
  {
   "id": "MAIN",
   "title": "Variation is the subject",
   "text": "Data vary, samples vary, and statistics is the craft of saying how much of what you see is signal. Every interval and test is a standard error and a multiplier."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Compute and interpret",
   "text": "Carry a statistic to a number and say in a sentence what it does and does not mean."
  }
 ],
 "units": [
  {
   "id": "one-variable",
