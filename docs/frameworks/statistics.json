       ]
      },
      {
       "id": "B",
       "std": [
        "webwork-opl:ST5.5"
       ],
       "do": "Build an interval for a difference of proportions.",
       "ek": [
        "p̂₁ − p̂₂ ± z* √(p̂₁q̂₁/n₁ + p̂₂q̂₂/n₂)."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "st-two-prop-margin"
       ]
      },
      {
       "id": "C",
       "std": [
        "webwork-opl:ST5.6"
       ],
