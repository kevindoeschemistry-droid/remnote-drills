     "los": [
      {
       "id": "A",
       "std": [
        "lay-5e:6"
       ],
       "do": "Test orthogonality, project one vector on another and take a Gram–Schmidt step.",
       "ek": [
        "proj = (u·v / v·v) v."
       ],
       "p": [
        "P1"
       ],
       "drills": [
