 ],
 "level": 3,
 "domains": [
  "la"
 ],
 "basis": {
  "primary": "lay-5e",
  "note": "Units follow the chapters of Lay's Linear Algebra and Its Applications (a textbook, not a standard). A published curriculum standard has not been looked for yet."
 },
 "big_ideas": [
  {
   "id": "MAIN",
   "title": "A matrix is a linear map",
   "text": "Every question (solvable or not, invertible or not, which directions are only stretched) is a question about what the map does to space."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Compute and interpret",
   "text": "Carry a calculation to a number or a vector and say what it means for the system or the map."
  }
 ],
 "units": [
  {
   "id": "systems",
   "n": 1,
   "title": "Linear systems and independence",
   "scope": "core",
   "std": [
    "lay-5e:1"
   ],
   "ideas": [
    "MAIN"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Row reduction",
     "los": [
      {
       "id": "A",
       "std": [
        "lay-5e:1"
       ],
       "do": "Solve a linear system by row reduction.",
       "ek": [
        "Pivots give the basic variables; a row 0 = c means no solution."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "la-system"
       ]
      },
      {
       "id": "B",
       "std": [
        "lay-5e:1"
       ],
       "do": "Decide whether a set of vectors is linearly independent.",
       "ek": [
        "Independent exactly when the only solution of Ax = 0 is zero."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "la-independence"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "matrix-algebra",
   "n": 2,
   "title": "Matrix algebra",
   "scope": "core",
   "std": [
    "lay-5e:2"
   ],
   "ideas": [
    "MAIN"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Inverses",
     "los": [
      {
       "id": "A",
       "std": [
        "lay-5e:2"
       ],
       "do": "Find the inverse of a 2 × 2 matrix.",
       "ek": [
        "Swap the diagonal, negate the off-diagonal, divide by the determinant."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "la-inverse"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "determinants",
   "n": 3,
   "title": "Determinants",
   "scope": "core",
   "std": [
    "lay-5e:3"
   ],
   "ideas": [
    "MAIN"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Cofactor expansion",
     "los": [
      {
       "id": "A",
       "std": [
        "lay-5e:3"
       ],
       "do": "Compute a 3 × 3 determinant.",
       "ek": [
        "Expand along the row or column with the most zeros."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "la-det",
        "mm-determinant"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "vector-spaces",
   "n": 4,
   "title": "Rank and the null space",
   "scope": "core",
   "std": [
    "lay-5e:4"
   ],
   "ideas": [
    "MAIN"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Rank",
     "los": [
      {
       "id": "A",
       "std": [
        "lay-5e:4"
       ],
       "do": "Find the rank of a matrix and use the rank theorem.",
       "ek": [
        "rank + dim Nul = number of columns."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "la-rank-3x3",
        "la-rank-nullity"
       ]
      }
     ]
    }
   ]
  },
  {
