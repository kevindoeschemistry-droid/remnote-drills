   "std": [
    "lay-5e:5"
   ],
   "ideas": [
    "MAIN"
   ],
   "topics": [
    {
     "n": 1,
     "title": "The eigenvalue problem",
     "los": [
      {
       "id": "A",
       "std": [
        "lay-5e:5"
       ],
       "do": "Find the eigenvalues and eigenvectors of a 2 × 2 matrix.",
