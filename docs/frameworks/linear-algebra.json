     "title": "Abstract vector spaces",
     "los": [
      {
       "id": "A",
       "std": [
        "webwork-opl:LA6.1",
        "webwork-opl:LA6.5"
       ],
       "do": "Decide whether a set with its operations is a vector space.",
       "ek": [
        "Check the zero vector, closure under addition and under scaling; the rest of the axioms usually come free."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "la-is-vector-space"
       ]
      },
      {
       "id": "B",
       "std": [
        "webwork-opl:LA6.2"
       ],
       "do": "Write a polynomial as a combination of other polynomials.",
       "ek": [
