       "id": "B",
       "std": [
        "lay-5e:5"
       ],
       "do": "Decide whether a matrix is diagonalisable and use the diagonal form.",
       "ek": [
        "n independent eigenvectors; powers act on the eigenvalues."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "la-diagonalizable-facts",
        "la-trace-of-power",
        "em-diagonalise"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "orthogonality",
