       ],
       "p": [
        "P1"
       ],
       "drills": [
        "la-poly-combination"
       ]
      },
      {
       "id": "C",
       "std": [
        "webwork-opl:LA6.3"
       ],
       "do": "Decide whether a polynomial lies in the span of others.",
       "ek": [
