       ],
       "p": [
        "P1"
       ],
       "drills": [
        "la-poly-dependence"
       ]
      },
      {
       "id": "E",
       "std": [
        "webwork-opl:LA6.8"
       ],
       "do": "Find the dimension of a standard space of matrices or polynomials.",
       "ek": [
        "Count the free entries: symmetric n(n+1)/2, skew n(n−1)/2, trace zero n² − 1, P_n has n + 1."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "la-space-dimension"
       ]
      },
      {
       "id": "F",
       "std": [
        "webwork-opl:LA8.2"
       ],
       "do": "Compute an inner product of functions.",
       "ek": [
