       ],
       "p": [
        "P1"
       ],
       "drills": [
        "la-poly-span"
       ]
      },
      {
       "id": "D",
       "std": [
        "webwork-opl:LA6.4"
       ],
       "do": "Decide when polynomials are linearly dependent.",
       "ek": [
