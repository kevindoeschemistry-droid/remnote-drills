       "id": "B",
       "std": [
        "lay-5e:6"
       ],
       "do": "Set up and solve a least-squares problem.",
       "ek": [
        "AᵀAx = Aᵀb."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "la-least-squares-slope",
        "la-least-squares-facts"
       ]
      }
     ]
    }
   ]
  },
