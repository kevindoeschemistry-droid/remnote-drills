       "id": "A",
       "std": [
        "harper-carroll-academy:7"
       ],
       "do": "Name the parts of an agent and the steps of its loop and of retrieval-augmented generation.",
       "ek": [
        "Model + tools + memory + loop; embed, retrieve, answer from context."
