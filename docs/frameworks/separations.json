       ],
       "drills": [
        "sp-vle-alpha"
       ]
      },
      {
       "id": "B",
       "do": "Compute the minimum number of stages with Fenske.",
       "ek": [
        "N_min = ln[(x_D/(1−x_D))((1−x_B)/x_B)]/ln α."
       ],
       "p": [
