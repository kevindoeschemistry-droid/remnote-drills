 "big_ideas": [
  {
   "id": "STAGE",
   "title": "A stage is an equilibrium plus a balance",
   "text": "Every separation is equilibrium relations (α, m, solubility) chained by mass balances; the number of stages measures how hard the split is."
  },
  {
   "id": "DRIVE",
   "title": "Separation needs a driving difference",
   "text": "Volatility, solubility or vapour pressure must differ, and the closer to 1 the ratio, the more stages or reflux it costs."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Compute",
   "text": "Carry the stage or balance calculation to a number."
  }
 ],
