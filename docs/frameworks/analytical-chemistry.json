 },
 "big_ideas": [
  {
   "id": "MOLES",
   "title": "Every analysis is a mole chain",
   "text": "Volume × concentration or mass ÷ molar mass, through a ratio, to the analyte. Titration, gravimetry and calibration differ only in the first link."
  },
  {
   "id": "EQ",
   "title": "Equilibrium sets the limits",
   "text": "Common ions, complexing agents and pH decide how much stays dissolved, how sharp an end point is and what precipitates first."
  },
  {
   "id": "ERROR",
   "title": "A number is not a result without its uncertainty",
   "text": "Replicates, calibration and propagation say how far to trust it; matrix effects say whether to trust it at all."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Compute",
   "text": "Carry the stoichiometric or equilibrium calculation to a number with the right units."
  },
  {
   "id": "P2",
   "title": "Choose",
   "text": "Pick the indicator, technique or test that fits."
  },
  {
   "id": "P3",
   "title": "Judge",
   "text": "Decide whether data support a result."
  }
 ],
