{
 "id": "inbde",
 "title": "INBDE (Dentistry)",
 "code": "DN",
 "draft": 1,
 "track": "health",
 "requires": [],
 "level": 3,
 "domains": [],
 "basis": {
  "primary": "jcnde-domain",
  "note": "Units are the Domain of Dentistry's three clinical sections plus Foundation Knowledge area 3 (materials); objectives cite the clinical content area or FK they serve and are ours."
 },
 "big_ideas": [
  {
   "id": "DX",
   "title": "Diagnosis drives treatment",
   "text": "Name the condition from its findings before choosing what to do."
  },
  {
   "id": "SAFE",
   "title": "Patient safety bounds every procedure",
   "text": "Dose limits, medical risk, emergencies and infection control come before the dentistry."
  },
  {
   "id": "MAT",
   "title": "A material's chemistry decides its handling and its failure",
   "text": "Setting reaction, filler, thermal expansion and modulus explain how to use a material and why restorations fail."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Calculate",
   "text": "Carry a dose, measurement or property to a number."
  },
  {
   "id": "P2",
   "title": "Diagnose",
   "text": "Name a condition from findings."
  },
  {
   "id": "P3",
   "title": "Know the rule",
   "text": "State the standard of care or the material behaviour."
  }
 ],
 "units": [
  {
   "id": "diagnosis",
   "n": 1,
   "title": "Diagnosis and Treatment Planning (36.2%)",
   "scope": "core",
   "ideas": [
    "DX"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Tooth notation and development",
     "los": [
      {
       "id": "A",
       "std": [
        "jcnde-domain:CC56"
       ],
       "do": "Convert between Universal and FDI notation, permanent and primary.",
       "ek": [
        "FDI: quadrant 1–4 (primary 5–8), then position from the midline."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "dn-universal-fdi",
        "dn-primary-fdi"
       ]
      },
      {
       "id": "B",
       "std": [
        "jcnde-domain:FK1"
       ],
       "do": "Recall the primary and permanent eruption sequence.",
       "ek": [
        "20 primary teeth by about 3; first molars at 6, second at 12."
       ],
       "p": [
        "P3"
       ],
       "drills": [
        "dn-eruption"
       ]
      }
     ]
    },
    {
     "n": 2,
     "title": "Caries, pulpal and periodontal diagnosis",
     "los": [
      {
       "id": "A",
       "std": [
        "jcnde-domain:CC4",
        "jcnde-domain:CC21"
       ],
       "do": "Classify a lesion by G. V. Black's classes.",
       "ek": [
        "I pits and fissures … VI cusp tips."
       ],
       "p": [
        "P2"
       ],
       "drills": [
        "dn-black-class"
       ]
      },
      {
       "id": "B",
       "std": [
        "jcnde-domain:CC20",
        "jcnde-domain:CC7"
       ],
       "do": "Make a pulpal diagnosis from thermal and electric tests.",
       "ek": [
        "Lingering pain is irreversible; no response is necrosis."
       ],
       "p": [
        "P2"
       ],
       "drills": [
        "dn-pulp-dx"
       ]
      },
      {
       "id": "C",
       "std": [
        "jcnde-domain:CC22"
       ],
       "do": "Compute clinical attachment level and stage periodontitis by it.",
       "ek": [
        "CAL from the CEJ; 1–2 mm stage I, 3–4 stage II, 5+ stage III or IV."
       ],
       "p": [
        "P1",
        "P2"
       ],
       "drills": [
        "dn-cal",
        "dn-perio-stage"
       ]
      }
     ]
    },
    {
     "n": 3,
     "title": "Radiographs",
     "los": [
      {
       "id": "A",
       "std": [
        "jcnde-domain:CC10"
       ],
       "do": "Localize objects with the SLOB rule and recognise angulation errors.",
       "ek": [
        "Same lingual, opposite buccal; vertical errors elongate or foreshorten."
       ],
       "p": [
        "P3"
       ],
       "drills": [
        "dn-radiography"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "management",
   "n": 2,
   "title": "Oral Health Management (42.0%)",
   "scope": "core",
   "ideas": [
    "SAFE"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Medical emergencies and prophylaxis",
     "los": [
      {
       "id": "A",
       "std": [
        "jcnde-domain:CC16"
       ],
       "do": "Give the first drug or action for common office emergencies.",
       "ek": [
        "Syncope: supine, legs up. Anaphylaxis: IM epinephrine. Angina: nitroglycerin."
       ],
       "p": [
        "P3"
       ],
       "drills": [
        "dn-emergency"
       ]
      },
      {
       "id": "B",
       "std": [
        "jcnde-domain:CC26"
       ],
       "do": "Decide who needs antibiotic prophylaxis against endocarditis and with what.",
       "ek": [
        "Prosthetic valves, previous IE, some congenital disease, transplant valvulopathy; amoxicillin 2 g."
       ],
       "p": [
        "P3"
       ],
       "drills": [
        "dn-prophylaxis"
       ]
      }
     ]
    },
    {
     "n": 2,
     "title": "Local anesthesia",
     "los": [
      {
       "id": "A",
       "std": [
        "jcnde-domain:CC19"
       ],
       "do": "Calculate maximum cartridges by weight and by epinephrine limit.",
       "ek": [
        "mg/mL = % × 10; 1.8 mL cartridges; 1:100,000 = 0.01 mg/mL."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "dn-la-max",
        "dn-epi-limit"
       ]
      },
      {
       "id": "B",
       "std": [
        "jcnde-domain:CC19",
        "jcnde-domain:FK8"
       ],
       "do": "Explain local anesthetic action, metabolism and the role of vasoconstrictors.",
       "ek": [
        "Uncharged base crosses the membrane; infection traps the cation; articaine is cleared in plasma."
       ],
       "p": [
        "P3"
       ],
       "drills": [
        "dn-la-facts"
       ]
      }
     ]
    },
    {
     "n": 3,
     "title": "Caries prevention: fluoride",
     "los": [
      {
       "id": "A",
       "std": [
        "jcnde-domain:CC21",
        "jcnde-domain:FK2"
       ],
       "do": "Convert NaF concentration to ppm fluoride and compute the probably toxic dose.",
       "ek": [
        "F is 45% of NaF; 1% = 10,000 ppm; PTD 5 mg F/kg."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "dn-fluoride-ppm",
        "dn-fluoride-ptd"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "practice",
   "n": 3,
   "title": "Practice and Profession (21.8%)",
   "scope": "core",
   "ideas": [
    "SAFE"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Infection control",
     "los": [
      {
       "id": "A",
       "std": [
        "jcnde-domain:CC51"
       ],
       "do": "Classify instruments (Spaulding) and state sterilization and monitoring standards.",
       "ek": [
        "Critical and semicritical items are sterilized; spore tests weekly."
       ],
       "p": [
        "P3"
       ],
       "drills": [
        "dn-spaulding",
        "dn-sterilization"
       ]
      }
     ]
    },
    {
     "n": 2,
     "title": "Evaluating evidence and diagnostic tests",
     "los": [
      {
       "id": "A",
       "std": [
        "jcnde-domain:CC41",
        "jcnde-domain:FK10"
       ],
       "do": "Compute sensitivity, specificity and predictive values from a 2×2 table.",
       "ek": [
        "Sensitivity and specificity belong to the test; predictive values depend on prevalence."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "dn-test-stats"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "materials",
   "n": 4,
   "title": "Dental materials (FK3, 8.0%)",
   "scope": "core",
   "std": [
    "jcnde-domain:FK3"
   ],
   "ideas": [
    "MAT"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Mechanical properties",
     "los": [
      {
       "id": "A",
       "do": "Compute stress, elastic modulus and Vickers hardness, and compare restoratives with enamel and dentin.",
       "ek": [
        "MPa = N/mm²; E = σ/ε; HV = 1.8544 F/d²."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "dn-stress",
        "dn-modulus",
        "dn-vickers"
       ]
      },
      {
       "id": "B",
       "std": [
        "jcnde-domain:CC30"
       ],
       "do": "Compute flexural strength from a three-point bend test.",
       "ek": [
        "σ = 3FL/(2bh²); ISO 4049 uses 2 × 2 mm bars on a 20 mm span."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "dn-flexural-strength"
       ]
      }
     ]
    },
    {
     "n": 2,
     "title": "Resin composites and their polymerization",
     "los": [
      {
       "id": "A",
       "std": [
        "jcnde-domain:CC30"
       ],
       "do": "Compute radiant exposure, depth of cure, shrinkage, C-factor and water sorption.",
       "ek": [
        "J/cm² = mW/cm² × s / 1000; depth = scraped length / 2; shrinkage = 1 − ρu/ρc."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "dn-radiant-exposure",
        "dn-depth-of-cure",
        "dn-shrinkage",
        "dn-c-factor",
        "dn-water-sorption"
       ]
      },
      {
       "id": "B",
       "do": "Explain what each composite component does and how filler changes properties.",
       "ek": [
        "Silane couples filler; camphorquinone absorbs blue light; oxygen inhibits the surface."
       ],
       "p": [
        "P3"
       ],
       "drills": [
        "dn-composite-types"
       ]
      }
     ]
    },
    {
     "n": 3,
     "title": "Thermal behaviour",
     "los": [
      {
       "id": "A",
       "do": "Compute the marginal gap from a thermal-expansion mismatch.",
       "ek": [
        "ΔL = Δα·L·ΔT; tooth about 11.4 ppm/°C."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "dn-thermal-gap"
       ]
      }
     ]
    },
    {
     "n": 4,
     "title": "Cements, amalgam and adhesion",
     "los": [
      {
       "id": "A",
       "std": [
        "jcnde-domain:CC30"
       ],
       "do": "Explain the setting and properties of amalgam, glass ionomer, zinc phosphate and ZOE, and how etching works.",
       "ek": [
        "High-copper removes γ₂; GI bonds and releases fluoride; eugenol inhibits resin."
       ],
       "p": [
        "P3"
       ],
       "drills": [
        "dn-restoratives"
       ]
      },
      {
       "id": "B",
       "std": [
        "jcnde-domain:CC31"
       ],
       "do": "Choose the surface treatment for bonding a ceramic restoration.",
       "ek": [
        "Glass ceramics: HF + silane. Zirconia: air abrasion + MDP."
       ],
       "p": [
        "P3"
       ],
       "drills": [
        "dn-ceramic-bonding"
       ]
      }
     ]
    },
    {
     "n": 5,
     "title": "Alloys, gypsum and impression materials",
     "los": [
      {
       "id": "A",
       "std": [
        "jcnde-domain:CC31"
       ],
       "do": "Classify a casting alloy by noble-metal content.",
       "ek": [
        "High noble ≥ 60% noble with ≥ 40% gold; noble ≥ 25%; silver is not noble."
       ],
       "p": [
        "P1",
        "P3"
       ],
       "drills": [
        "dn-noble-class"
       ]
      },
      {
       "id": "B",
       "std": [
        "jcnde-domain:CC56"
       ],
       "do": "Mix gypsum at the right water/powder ratio and choose and handle impression materials.",
       "ek": [
        "W/P 0.50 plaster, 0.30 stone, 0.24 die stone; pour alginate at once; PVS is the most stable."
       ],
       "p": [
        "P1",
        "P3"
       ],
       "drills": [
        "dn-gypsum-water",
        "dn-impression"
       ]
      }
     ]
    }
   ]
  }
 ],
