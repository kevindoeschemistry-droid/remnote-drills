{
 "id": "nclex-rn",
 "title": "NCLEX-RN",
 "code": "NR",
 "draft": 1,
 "track": "health",
 "requires": [],
 "level": 3,
 "domains": [],
 "basis": {
  "primary": "ncsbn-nclex-rn",
  "note": "Units are the test plan's eight Client Needs subcategories (with their weights); topics group its related-content items; the objectives are ours."
 },
 "big_ideas": [
  {
   "id": "SAFE",
   "title": "Safety first, then the rest",
   "text": "Airway, breathing, circulation; acute over chronic; unstable over stable; the least invasive action that protects the client."
  },
  {
   "id": "CALC",
   "title": "Every dose is a ratio",
   "text": "Desired over have, per kilogram, per hour; units carried through and the answer checked against a safe range."
  },
  {
   "id": "CUES",
   "title": "Findings are cues to interpret",
   "text": "A lab value, a vital sign or a symptom means something only against its range and the client's condition."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Calculate",
   "text": "Carry an order to a dose, rate or score."
  },
  {
   "id": "P2",
   "title": "Prioritize",
   "text": "Choose who or what comes first, and who does it."
  },
  {
   "id": "P3",
   "title": "Interpret",
   "text": "Read a finding against its range and name what it means."
  },
  {
   "id": "P4",
   "title": "Know the rule",
   "text": "State the standard of care."
  }
 ],
