{
 "id": "material-balances",
 "title": "Material and Energy Balances",
 "code": "MB",
 "draft": 1,
 "track": "engineering",
 "requires": [
  "chemistry"
 ],
 "level": 4,
 "domains": [
  "meb"
 ],
 "basis": {
  "primary": "fe-chemical",
  "also": [
   "pe-chemical",
   "webwork-opl"
  ],
  "note": "Topics from FE Chemical area 8, read in full. Objectives and their order are ours and follow the usual textbook sequence; unit 1 is assumed by the spec rather than listed."
 },
 "big_ideas": [
  {
   "id": "CONSERVE",
   "title": "In minus out plus generation equals accumulation",
   "text": "Every problem is this one sentence applied to a chosen boundary and a chosen quantity. Mass and energy are conserved; moles of a species are not when it reacts."
  },
  {
   "id": "BOUNDARY",
   "title": "The boundary is a choice",
   "text": "A box around the whole process hides the recycle; a box around the mixing point exposes it. Picking the boundary that cuts the fewest unknowns is most of the work."
  },
  {
   "id": "BASIS",
   "title": "Pick a basis and count unknowns before solving",
   "text": "Flows scale freely until one is fixed. Degrees of freedom say whether the problem can be solved before any algebra is done."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Set up",
   "text": "Draw the boundary, choose a basis, name the unknowns and count the independent equations."
  },
  {
   "id": "P2",
   "title": "Solve",
   "text": "Write the balances and solve for the unknown, carrying units."
  },
  {
   "id": "P3",
   "title": "Judge",
   "text": "Say which balance or boundary to use and whether an answer is physically sensible."
  }
 ],
 "units": [
  {
   "id": "variables",
   "n": 1,
   "title": "Process variables",
   "scope": "core",
   "ideas": [
    "BASIS"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Composition and flow",
     "los": [
      {
       "id": "A",
       "std": [
        "webwork-opl:TH1.5",
        "webwork-opl:TH12.1"
       ],
       "do": "Convert between mass fractions and mole fractions, and find the average molar mass of a mixture.",
       "ek": [
        "Take 100 g or 1 mol as a basis; the average molar mass is the mole-fraction-weighted mean."
       ],
       "p": [
        "P2"
       ],
       "needs": [
        "CH-0.3.A"
       ],
       "drills": [
        "mb-mass-to-mole-fraction",
        "mb-average-molar-mass"
       ]
      },
      {
       "id": "B",
       "std": [
        "webwork-opl:TH4.1"
       ],
       "do": "Convert a volumetric flow of a liquid or an ideal gas to a molar flow.",
       "ek": [
        "Liquid: density then molar mass. Gas: n = PV/RT, with T in kelvin."
       ],
       "p": [
        "P2"
       ],
       "needs": [
        "MB-1.1.A"
       ],
       "drills": [
        "mb-liquid-molar-flow",
        "mb-ideal-gas-molar-flow"
       ]
      }
     ]
    }
   ]
  },
