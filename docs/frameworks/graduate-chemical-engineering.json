 "big_ideas": [
  {
   "id": "SOLVE",
   "title": "Solve the governing equation, then read off the quantity",
   "text": "A velocity, temperature or concentration field comes from a balance with its boundary conditions; forces, fluxes and rates are integrals or gradients of that field."
  },
  {
   "id": "STABLE",
   "title": "Steady is not the same as stable",
   "text": "A reactor, a mixture or a control loop can sit at a solution of its equations and still run away from it; a slope or a curvature decides."
  }
 ],
