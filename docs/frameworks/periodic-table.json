   ],
   "ideas": [
    "POSITION"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Symbols and numbers",
     "los": [
      {
       "id": "A",
       "do": "Give the atomic number of any main-group element.",
       "ek": [
        "Noble gases at 2, 10, 18, 36, 54, 86, 118 anchor each row."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "pt-number-main"
       ]
      },
      {
       "id": "B",
       "do": "Write the heavy p-block row from memory.",
       "ek": [
        "Tl Pb Bi Po At Rn, 81 to 86."
       ],
       "p": [
        "P2"
       ],
       "drills": [
        "pt-write-p-block-heavy"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "d-block",
   "n": 2,
   "title": "The d block",
   "scope": "core",
   "std": [
    "iupac-periodic-table:d"
   ],
   "ideas": [
    "POSITION",
    "TRIADS"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Positions",
     "los": [
      {
       "id": "A",
       "do": "Give the atomic number of any transition metal.",
       "ek": [
        "3d 21-30, 4d 39-48, 5d 72-80, 6d 104-112."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "pt-number-d-block"
       ]
      },
      {
       "id": "B",
       "do": "Give the group of any transition metal.",
       "ek": [
        "Group number = s + d valence electrons."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "pt-group-d-block"
       ]
      },
      {
       "id": "C",
       "do": "Name the element below a given transition metal, and write a triad.",
       "ek": [
        "Add 18, then 32; the lanthanoids sit between the 4d and 5d rows."
       ],
       "p": [
        "P1",
        "P2"
       ],
       "drills": [
        "pt-congener-below",
        "pt-write-triad"
       ]
      },
      {
       "id": "D",
       "do": "Write each d row from memory, in order.",
       "ek": [
        "Sc Ti V Cr Mn Fe Co Ni Cu Zn; Y Zr Nb Mo Tc Ru Rh Pd Ag Cd; Hf Ta W Re Os Ir Pt Au Hg."
       ],
       "p": [
        "P2"
       ],
       "drills": [
        "pt-write-3d",
        "pt-write-4d",
        "pt-write-5d",
        "pt-write-6d"
       ]
      }
     ]
    },
    {
     "n": 2,
     "title": "Electron counts",
     "los": [
      {
       "id": "A",
       "do": "Give the d-electron count of a metal in a stated oxidation state.",
       "ek": [
        "d count = group − oxidation state."
       ],
       "p": [
        "P3"
       ],
       "drills": [
        "pt-d-electron-count"
       ]
      }
     ]
    }
   ]
  },
