{
 "id": "periodic-table",
 "title": "The Periodic Table from Memory",
 "code": "PT",
 "draft": 1,
 "track": "science",
 "requires": [
  "chemistry"
 ],
 "level": 3,
 "domains": [
  "ptable"
 ],
 "basis": {
  "primary": "iupac-periodic-table",
  "note": "Content from the IUPAC table (release note read; element list cross-checked in the verifier). Which parts to know by heart is a house decision from Kevin's organometallics course."
 },
 "big_ideas": [
  {
   "id": "POSITION",
   "title": "Position is the electron count",
   "text": "A transition metal's group number is its valence-electron count, and group minus oxidation state is its d count. Knowing where an element sits is the first step of every electron-counting argument."
  },
  {
   "id": "TRIADS",
   "title": "Columns, not just rows",
   "text": "Chemistry runs down the groups. The 4d and 5d members of a triad are close in size because the lanthanoids sit between them."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Recall",
   "text": "Give a number, symbol, group or neighbour without working it out."
  },
  {
   "id": "P2",
   "title": "Reproduce",
   "text": "Write a whole row or column from memory, in order."
  },
  {
   "id": "P3",
   "title": "Count",
   "text": "Turn position and oxidation state into a d or f electron count."
  }
 ],
 "units": [
  {
   "id": "main-group",
   "n": 1,
   "title": "Main-group elements",
   "scope": "core",
   "std": [
