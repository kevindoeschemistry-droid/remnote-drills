{
 "id": "inorganic-advanced",
 "title": "Advanced Inorganic Chemistry (Cotton & Wilkinson)",
 "code": "IA",
 "draft": 1,
 "track": "science",
 "requires": [
  "inorganic-chemistry"
 ],
 "level": 5,
 "domains": [
  "inorg"
 ],
 "basis": {
  "primary": "cotton-wilkinson-6e",
  "also": [
   "icho-appendix-c",
   "gre-chemistry"
  ],
  "note": "Units follow the chapters of Cotton & Wilkinson 6e (table of contents read); the objectives are a house list on those chapters."
 },
 "big_ideas": [
  {
   "id": "COUNT",
   "title": "Count electrons",
   "text": "Shapes, bond orders, cluster types and oxidation states all come from counting valence electrons and placing them."
  },
  {
   "id": "TREND",
   "title": "Trends and their exceptions",
   "text": "Size, charge and electronegativity change steadily across and down the table; the first row and the heaviest elements are where the named exceptions live."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Compute",
   "text": "Carry an electron count, oxidation state or energy to a number."
  },
  {
   "id": "P2",
   "title": "Recall",
   "text": "Know the compound, the product, the structure."
  },
  {
   "id": "P3",
   "title": "Predict",
   "text": "Use a model (VSEPR, MO, Wade, HSAB) to say what a species does."
  }
 ],
 "units": [
  {
   "id": "cross-cutting",
   "n": 1,
   "title": "Some cross-cutting topics (ch. 1)",
   "scope": "core",
   "ideas": [
    "COUNT"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Acids, bases and redox diagrams",
     "los": [
      {
       "id": "A",
       "do": "Classify acids and bases as hard, soft or borderline and predict which pairs bind.",
       "ek": [
        "Hard prefers hard, soft prefers soft."
       ],
       "p": [
        "P2",
        "P3"
       ],
       "drills": [
        "cw-hsab-class"
       ]
      },
      {
       "id": "B",
       "do": "Combine Latimer-diagram steps through free energies.",
       "ek": [
        "E = Σ nE / Σ n."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "cw-latimer-skip"
       ]
      },
      {
       "id": "C",
       "do": "Decide from a Latimer diagram whether a species disproportionates.",
       "ek": [
        "E_right > E_left: it disproportionates."
       ],
       "p": [
        "P1",
        "P3"
       ],
       "needs": [
        "IA-1.1.B"
       ],
       "drills": [
        "cw-disproportionation"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "hydrogen",
   "n": 2,
   "title": "Hydrogen (ch. 2)",
   "scope": "core",
   "ideas": [
    "TREND"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Hydrides and isotopes",
     "los": [
      {
       "id": "A",
       "do": "Classify a hydride as saline, molecular or metallic.",
       "ek": [
        "s-block saline; p-block molecular; many d-block interstitial."
       ],
       "p": [
        "P2"
       ],
       "drills": [
        "cw-hydride-type"
       ]
      },
      {
       "id": "B",
       "do": "Predict the shift of a vibration on deuteration from reduced masses.",
       "ek": [
        "ν ∝ 1/√μ; X–D ≈ 0.73 × X–H."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "cw-isotope-shift"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "s-block",
   "n": 3,
   "title": "Groups 1 and 2 (ch. 3–4)",
   "scope": "core",
   "ideas": [
    "TREND"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Alkali and alkaline-earth metals",
     "los": [
      {
       "id": "A",
       "do": "Give the product of burning an alkali metal, and the oxidation state in oxides, peroxides and superoxides.",
       "ek": [
        "Li₂O, Na₂O₂, KO₂; O −2, −1, −½."
       ],
       "p": [
        "P1",
        "P2"
       ],
       "drills": [
        "cw-alkali-burn",
        "cw-dioxygen-anion-ox"
       ]
      },
      {
       "id": "B",
       "do": "Rank the thermal stability of group 2 carbonates.",
       "ek": [
        "Rises down the group as cations grow less polarising."
       ],
       "p": [
        "P3"
       ],
       "drills": [
        "cw-carbonate-stability"
       ]
      },
      {
       "id": "C",
       "do": "Use the diagonal relationship.",
       "ek": [
        "Li–Mg, Be–Al, B–Si."
       ],
       "p": [
        "P2"
       ],
       "drills": [
        "cw-diagonal"
       ]
      }
     ]
    }
   ]
  },
