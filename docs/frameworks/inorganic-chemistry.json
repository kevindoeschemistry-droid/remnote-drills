{
 "id": "inorganic-chemistry",
 "title": "Inorganic Chemistry",
 "code": "IN",
 "draft": 1,
 "track": "science",
 "requires": [
  "chemistry",
  "periodic-table"
 ],
 "level": 4,
 "domains": [
  "inorg"
 ],
 "basis": {
  "primary": "icho-appendix-c",
  "also": [
   "icho-syllabus",
   "gre-chemistry",
   "usnco",
   "ib-chemistry-2025"
  ],
  "note": "Units 1, 2 and 4 follow IChO Appendix D's factual-knowledge list (read in full); coordination and solids follow its preparation-only topics and the GRE inorganic area. Objectives and their order are ours."
 },
 "big_ideas": [
  {
   "id": "COUNT",
   "title": "Count electrons first",
   "text": "Oxidation states, d counts, half-equations and titration ratios are all electron bookkeeping. Get the count and the rest follows."
  },
  {
   "id": "SPLIT",
   "title": "Ligands split the d orbitals",
   "text": "Geometry and ligand strength set the splitting; the splitting sets spin, colour, magnetism and stability."
  },
  {
   "id": "TREND",
   "title": "Position predicts behaviour",
   "text": "Down a group ions grow and oxides turn basic; across a period oxides turn acidic. Most descriptive facts are a trend with a few named exceptions."
  },
  {
   "id": "PACK",
   "title": "Solids are geometry",
   "text": "Where atoms sit in the cell fixes how many there are, how many neighbours each has, how full the space is and how X-rays scatter."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Compute",
   "text": "Carry an oxidation-state, electron or lattice calculation to a number."
  },
  {
   "id": "P2",
   "title": "Recall",
   "text": "Know the colour, the product, the test."
  },
  {
   "id": "P3",
   "title": "Predict",
   "text": "Use a trend or a model to say what will happen."
  }
 ],
