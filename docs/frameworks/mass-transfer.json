{
 "id": "mass-transfer",
 "title": "Mass Transfer",
 "code": "MS",
 "draft": 1,
 "track": "engineering",
 "requires": [
  "heat-transfer",
  "engineering-math"
 ],
 "level": 5,
 "domains": [
  "mass"
 ],
 "basis": {
  "primary": "pe-chemical",
  "note": "PE Chemical names mass transfer as one area with two lines (6.A fundamentals, 6.B applications). No published standard lists graduate mass transfer; the objectives are a house list on Bird, Stewart & Lightfoot's mass-transport chapters."
 },
 "big_ideas": [
  {
   "id": "FLUX",
   "title": "Fluxes need a reference frame",
   "text": "A diffusive flux is measured relative to a mean velocity; the total flux adds the bulk flow. Which one a problem fixes (stagnant B, equimolar counterdiffusion) decides the answer."
  },
  {
   "id": "SCALE",
   "title": "Time and length scales decide the regime",
   "text": "L²/D, the Thiele modulus and the Biot and Sherwood numbers say which resistance controls before any equation is solved."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Compute",
   "text": "Carry a flux, coefficient or time to a number with units."
  },
  {
   "id": "P2",
   "title": "Scale",
   "text": "Predict how a result changes when D, L, T or a flow changes, from the governing equation."
  }
 ],
 "units": [
  {
   "id": "diffusivity",
   "n": 1,
   "title": "Diffusivities and fluxes",
   "scope": "core",
   "std": [
    "pe-chemical:6.A"
   ],
   "ideas": [
    "FLUX"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Estimating diffusivities",
     "los": [
      {
       "id": "A",
       "std": [
        "pe-chemical:6.A"
       ],
       "do": "Scale a gas diffusivity with temperature and pressure.",
       "ek": [
        "Chapman–Enskog: D_AB ∝ T^{3/2}/(P σ² Ω_D); ignoring the collision integral, D ∝ T^{3/2}/P."
       ],
       "p": [
        "P1"
       ],
       "needs": [
        "HT-14.2.B"
       ],
       "drills": [
        "ms-gas-diffusivity-scaling",
        "ms-diffusivity-temperature-reverse"
       ]
      },
      {
       "id": "B",
       "std": [
        "pe-chemical:6.A"
       ],
       "do": "Scale a liquid diffusivity with temperature and viscosity.",
       "ek": [
        "Stokes–Einstein: D = kT/(6πμa), so D μ/T is constant."
       ],
       "p": [
        "P1"
       ],
       "needs": [
        "MS-1.1.A"
       ],
       "drills": [
        "ms-liquid-diffusivity-scaling",
        "ms-stokes-einstein-radius"
       ]
      },
      {
       "id": "C",
       "std": [
        "pe-chemical:6.A"
       ],
       "do": "Estimate a Knudsen diffusivity and decide the regime.",
       "ek": [
        "D_K = (d/3)√(8RT/πM); Knudsen diffusion takes over when the pore is smaller than the mean free path."
       ],
       "p": [
        "P1"
       ],
       "needs": [
        "MS-1.1.B"
       ],
       "drills": [
        "ms-knudsen",
        "ms-knudsen-crossover"
       ]
      },
      {
       "id": "D",
       "std": [
        "pe-chemical:6.A"
       ],
       "do": "Find an effective diffusivity in a porous solid.",
       "ek": [
        "D_eff = D ε/τ."
       ],
       "p": [
        "P1"
       ],
       "needs": [
        "MS-1.1.C"
       ],
       "drills": [
        "ms-effective-diffusivity",
        "ms-tortuosity-from-deff"
       ]
      }
     ]
    },
    {
     "n": 2,
     "title": "Fluxes and reference frames",
     "los": [
      {
       "id": "A",
       "std": [
        "pe-chemical:6.A"
       ],
       "do": "Find the flux for diffusion through a stagnant gas.",
       "ek": [
        "N_A = (cD/L) ln[(1 − x_A2)/(1 − x_A1)] (Stefan tube)."
       ],
       "p": [
        "P1"
       ],
       "needs": [
        "MS-1.1.D"
       ],
       "drills": [
        "ms-stagnant-film",
        "ms-stefan-tube-time"
       ]
      },
      {
       "id": "B",
       "std": [
        "pe-chemical:6.A"
       ],
       "do": "Compare stagnant-film and equimolar fluxes.",
       "ek": [
        "N_stagnant/N_equimolar = 1/x_B,lm."
       ],
       "p": [
        "P1"
       ],
       "needs": [
        "MS-1.2.A"
       ],
       "drills": [
        "ms-bulk-flow-factor",
        "ms-log-mean-xb"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "steady",
   "n": 2,
   "title": "Steady diffusion with reaction and geometry",
   "scope": "core",
   "std": [
    "pe-chemical:6.A",
    "pe-chemical:6.B"
   ],
   "ideas": [
    "FLUX"
   ],
   "topics": [
    {
     "n": 1,
     "title": "Shell balances",
     "los": [
      {
       "id": "A",
       "std": [
        "pe-chemical:6.A"
       ],
       "do": "Find the effectiveness factor of a catalyst slab.",
       "ek": [
        "η = tanh φ / φ with φ = L√(k/D_eff)."
       ],
       "p": [
        "P1"
       ],
       "needs": [
        "MS-1.2.B",
        "EM-3.2.B"
       ],
       "drills": [
        "ms-effectiveness-slab",
        "ms-slab-size-effect"
       ]
      },
      {
       "id": "B",
       "std": [
        "pe-chemical:6.A"
       ],
       "do": "Find the effectiveness factor of a spherical pellet.",
       "ek": [
        "η = (3/φ²)(φ coth φ − 1) with φ = R√(k/D_eff)."
       ],
       "p": [
        "P1"
       ],
       "needs": [
        "MS-2.1.A"
       ],
       "drills": [
        "ms-effectiveness-sphere",
        "ms-sphere-observed-rate"
       ]
      },
      {
       "id": "C",
       "std": [
        "pe-chemical:6.A"
       ],
       "do": "Find steady diffusion through a spherical shell.",
       "ek": [
        "Ẇ = 4πD(c₁ − c₂)/(1/r₁ − 1/r₂)."
       ],
       "p": [
        "P1"
       ],
       "needs": [
        "MS-2.1.B"
       ],
       "drills": [
        "ms-spherical-shell",
        "ms-shell-vs-slab"
       ]
      },
      {
       "id": "D",
       "std": [
        "pe-chemical:6.A"
       ],
       "do": "Find the lifetime of an evaporating droplet.",
       "ek": [
        "Quasi-steady, Sh = 2: d(d²)/dt is constant (the d² law)."
       ],
       "p": [
        "P1"
       ],
       "needs": [
        "MS-2.1.C"
       ],
       "drills": [
        "ms-droplet-lifetime",
        "ms-droplet-fraction-time"
       ]
      },
      {
       "id": "E",
       "std": [
        "pe-chemical:6.B"
       ],
       "do": "Find the absorption coefficient into a falling film.",
       "ek": [
        "Penetration theory: k̄ = 2√(D/πt) with contact time t = L/v_max."
       ],
       "p": [
        "P1"
       ],
       "needs": [
        "MS-2.1.D"
       ],
       "drills": [
        "ms-film-absorption",
        "ms-penetration-scaling"
       ]
      }
     ]
    }
   ]
  },
  {
