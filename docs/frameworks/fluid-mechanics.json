      {
       "id": "A",
       "std": [
        "fe-chemical:6.A",
        "webwork-opl:TH1.6",
        "webwork-opl:FM1.2",
        "webwork-opl:FM1.3"
       ],
       "do": "Relate dynamic and kinematic viscosity, density and specific gravity.",
       "ek": [
        "ν = μ/ρ. Water is about 1 mm²/s, air about 15."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "fm-kinematic-viscosity"
       ]
      }
     ]
    },
    {
     "n": 2,
     "title": "Statics",
     "los": [
      {
       "id": "A",
       "std": [
        "fe-chemical:6.A",
        "webwork-opl:FM2.1",
        "webwork-opl:FM2.2"
       ],
       "do": "Compute hydrostatic pressure and read a U-tube manometer.",
       "ek": [
        "P = ρgh; across a manometer only the density difference counts."
       ],
       "p": [
        "P1",
        "P3"
       ],
       "drills": [
        "fm-hydrostatic-pressure",
        "fm-manometer"
       ]
      },
      {
       "id": "B",
       "std": [
        "webwork-opl:FM2.6"
       ],
       "do": "Apply Archimedes' principle to a floating body.",
       "ek": [
        "Submerged fraction = body density over fluid density."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "fm-floating-fraction"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "regimes",
   "n": 2,
   "title": "Dimensionless numbers and flow regime",
   "scope": "core",
