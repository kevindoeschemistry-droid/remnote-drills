{
 "id": "fluid-mechanics",
 "title": "Fluid Mechanics",
 "code": "FM",
 "draft": 1,
 "track": "engineering",
 "requires": [
  "engineering-math",
  "physics"
 ],
 "level": 4,
 "domains": [
  "fm"
 ],
 "basis": {
  "primary": "fe-chemical",
  "also": [
   "pe-chemical",
   "webwork-opl"
  ],
  "note": "Topics from FE Chemical area 6, read in full; units 7–10 extend past it on the WeBWorK OPL fluid-mechanics sections (read in full). Objectives and their order are ours; statics is assumed by the spec rather than listed."
 },
 "big_ideas": [
  {
   "id": "HEAD",
   "title": "Everything is a head",
   "text": "Pressure, velocity, elevation, friction and pump work can all be written as metres of fluid. The mechanical energy balance is bookkeeping in that one currency."
  },
  {
   "id": "REGIME",
   "title": "Find the regime first",
   "text": "A Reynolds number, or a Mach number, decides which equations apply. Compute it before anything else."
  },
  {
   "id": "CONSERVE",
   "title": "Mass in equals mass out",
   "text": "Continuity fixes how velocity changes with area; Bernoulli then fixes how pressure changes with velocity."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Compute",
   "text": "Carry a calculation through in SI units to a number with the right order of magnitude."
  },
  {
   "id": "P2",
   "title": "Classify",
   "text": "Decide the regime, the kind of fluid or the right instrument from what is given."
  },
  {
   "id": "P3",
   "title": "Set up",
   "text": "Choose the two points and the terms that survive in an energy balance."
  }
 ],
 "units": [
  {
   "id": "statics",
   "n": 1,
   "title": "Properties and statics",
   "scope": "core",
