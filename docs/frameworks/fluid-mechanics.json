      },
      {
       "id": "B",
       "std": [
        "fe-chemical:6.E",
        "webwork-opl:FM6.3"
       ],
       "do": "Classify pipe flow as laminar, transitional or turbulent.",
       "ek": [
        "Laminar below about 2100, turbulent above about 4000."
       ],
       "p": [
        "P2"
       ],
       "drills": [
        "fm-flow-regime"
       ]
      },
