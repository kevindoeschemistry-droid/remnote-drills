       ]
      },
      {
       "id": "B",
       "do": "Find the fraction of fluid leaving before or after a time for one or more ideal tanks.",
       "ek": [
        "F = 1 − e^(−nθ) Σ (nθ)^i/i!."
       ],
       "p": [
