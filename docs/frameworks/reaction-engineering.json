   ],
   "topics": [
    {
     "n": 1,
     "title": "Residence-time distributions",
     "los": [
      {
       "id": "A",
       "do": "Compute the mean residence time and variance from pulse-tracer data.",
       "ek": [
        "t_m = ∫tE dt, σ² = ∫(t − t_m)²E dt."
       ],
       "p": [
        "P1"
       ],
       "needs": [
        "RE-2.2.A",
        "RE-2.4.A"
       ],
       "drills": [
