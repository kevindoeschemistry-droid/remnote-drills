      {
       "id": "B",
       "std": [
        "fe-chemical:12.A"
       ],
       "do": "Compute a first-order half-life.",
       "ek": [
        "t½ = ln 2 / k, independent of the starting concentration."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "cre-half-life"
       ]
      }
     ]
    },
    {
