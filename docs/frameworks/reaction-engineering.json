     "title": "Rate laws and order",
     "los": [
      {
       "id": "A",
       "std": [
        "fe-chemical:12.A"
       ],
       "do": "Evaluate a power-law rate, find the order from how the rate responds to concentration, and read the order from the units of k.",
       "ek": [
        "Doubling C multiplies an nth-order rate by 2ⁿ; k carries (mol/L)^(1−n) per time."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "cre-rate-from-law",
        "cre-order-from-doubling",
        "cre-rate-constant-units"
       ]
