       "id": "A",
       "std": [
        "fe-chemical:12.B"
       ],
       "do": "Use the Arrhenius equation to find how k changes with temperature, and the activation energy from two rate constants.",
       "ek": [
        "ln(k₂/k₁) = (Eₐ/R)(1/T₁ − 1/T₂), kelvin and joules."
       ],
       "p": [
        "P1"
       ],
       "drills": [
        "cre-arrhenius-ratio",
        "cre-activation-energy"
       ]
      }
     ]
