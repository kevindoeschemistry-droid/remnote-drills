  "note": "Topics from FE Chemical area 12, read in full. Objectives and their order are ours. Units 5–8 and the later letters of units 1–4 go beyond the FE spec on Fogler 5e's chapter order (a house list); the gaps are in the file header."
 },
 "big_ideas": [
  {
   "id": "BALANCE",
   "title": "A reactor is a mole balance with a rate law in it",
   "text": "In minus out plus generation equals accumulation. Batch, CSTR and PFR differ only in which terms survive and where the rate is evaluated."
  },
  {
   "id": "CONCENTRATION",
   "title": "The rate lives at the local concentration",
   "text": "A stirred tank reacts at its exit concentration; a tube reacts at every concentration on the way down. That one fact explains reactor size and selectivity."
  },
  {
   "id": "TIME",
   "title": "Compare the reaction time to the residence time",
   "text": "The Damköhler number, kτ for first order, says how much will react before the fluid leaves."
  }
 ],
 "practices": [
  {
   "id": "P1",
   "title": "Compute",
   "text": "Carry a design equation to a number."
  },
  {
   "id": "P2",
   "title": "Choose",
   "text": "Pick the reactor or the operating condition from the kinetics."
  }
 ],
