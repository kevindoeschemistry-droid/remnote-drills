{
  "name": "wiki-sync",
  "version": "0.18.0",
  "private": true,
  "pluginManifest": {
    "id": "wiki-sync",
    "name": "Wiki Sync",
    "description": "Syncs flashcards from wiki.kevindoeschemistry.com into RemNote",
    "version": "0.18.0",
    "reqs": []
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --config webpack.config.js",
    "build": "cross-env NODE_ENV=production webpack --config webpack.config.js && cd dist && bestzip ../PluginZip.zip ./*",
    "check-types": "npm run skills && tsc --noEmit",
    "test": "tsx tests/run.ts && python3 tests/verify_sympy.py",
    "skills": "node scripts/build-skills.mjs",
    "predev": "npm run skills",
    "prebuild": "npm run skills",
    "pretest": "npm run skills"
  },
  "dependencies": {
    "@remnote/plugin-sdk": "latest",
    "glob": "^8.1.0",
    "katex": "^0.16.47",
    "mathjs": "^13.2.3",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "style-loader": "^3.3.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/node": "^16.0.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "bestzip": "^2.2.1",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.1",
    "esbuild-loader": "^2.19.0",
    "html-webpack-plugin": "^5.5.0",
    "js-yaml": "^4.3.2",
    "mini-css-extract-plugin": "^2.6.1",
    "shx": "^0.3.4",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.15",
    "typescript": "4.7.4",
    "webpack": "5.73.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.9.3"
  }
}
